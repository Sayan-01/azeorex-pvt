{
  "__body": {
    "id": "__body",
    "name": "Body",
    "type": "__body",
    "parentId": null,
    "children": ["hero-container"],
    "styles": {
      "minHeight": "100vh",
      "backgroundColor": "#ffffff",
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "center",
      "padding": "60px 24px",
      "fontFamily": "system-ui, -apple-system, sans-serif",
      "color": "#09090b",
      "borderColor": "#000000"
    }
  },
  "hero-container": {
    "id": "hero-container",
    "name": "Hero Container",
    "type": "container",
    "parentId": "__body",
    "children": ["hero-badge", "hero-title", "hero-subtitle", "hero-actions"],
    "styles": {
      "maxWidth": "680px",
      "width": "100%",
      "display": "flex",
      "flexDirection": "column",
      "alignItems": "center",
      "textAlign": "center",
      "margin": "0 auto",
      "borderColor": "#000000"
    }
  },
  "hero-badge": {
    "id": "hero-badge",
    "name": "Badge",
    "type": "text",
    "parentId": "hero-container",
    "children": [],
    "content": "✨ AI-Powered Website Canvas",
    "styles": {
      "fontSize": "12px",
      "fontWeight": "500",
      "letterSpacing": "0.05em",
      "color": "#52525b",
      "backgroundColor": "#e8e8e8",
      "border": "1px solid #e4e4e7",
      "borderRadius": "9999px",
      "padding": "6px 14px",
      "marginBottom": "24px",
      "display": "inline-block"
    }
  },
  "hero-title": {
    "id": "hero-title",
    "name": "Heading",
    "type": "h1",
    "parentId": "hero-container",
    "children": [],
    "content": "Build Stunning Websites in Seconds",
    "styles": {
      "fontSize": "44px",
      "fontWeight": "700",
      "lineHeight": "1.15",
      "letterSpacing": "-0.03em",
      "color": "#09090b",
      "marginBottom": "16px"
    }
  },
  "hero-subtitle": {
    "id": "hero-subtitle",
    "name": "Subtitle",
    "type": "text",
    "parentId": "hero-container",
    "children": [],
    "content": "Use the AI Chat on the left to generate entire pages, or click any element here to edit text and styles directly.",
    "styles": {
      "fontSize": "16px",
      "lineHeight": "1.6",
      "color": "#71717a",
      "maxWidth": "520px",
      "marginBottom": "32px"
    }
  },
  "hero-actions": {
    "id": "hero-actions",
    "name": "Actions Wrapper",
    "type": "container",
    "parentId": "hero-container",
    "children": ["hero-btn-primary", "hero-btn-secondary"],
    "styles": {
      "display": "flex",
      "gap": "12px",
      "justifyContent": "center",
      "flexWrap": "wrap"
    }
  },
  "hero-btn-primary": {
    "id": "hero-btn-primary",
    "name": "Primary Button",
    "type": "button",
    "parentId": "hero-actions",
    "children": [],
    "content": "Start Prompting",
    "styles": {
      "backgroundColor": "#09090b",
      "color": "#ffffff",
      "fontSize": "14px",
      "fontWeight": "600",
      "padding": "10px 22px",
      "borderRadius": "8px",
      "border": "none",
      "cursor": "pointer"
    }
  },
  "hero-btn-secondary": {
    "id": "hero-btn-secondary",
    "name": "Secondary Button",
    "type": "button",
    "parentId": "hero-actions",
    "children": [],
    "content": "Explore Elements",
    "styles": {
      "backgroundColor": "#ffffff",
      "color": "#09090b",
      "fontSize": "14px",
      "fontWeight": "500",
      "padding": "10px 22px",
      "borderRadius": "8px",
      "border": "1px solid #e4e4e7",
      "cursor": "pointer",
      "borderColor": "#cccccc"
    }
  }
}
